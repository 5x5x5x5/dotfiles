set nocompatible

syntax on

set shortmess+=I

" Show number lines
set number

set relativenumber

" Always show the status line at the bottom, even if you only have one window
" open
set laststatus=2

set backspace=indent,eol,start

set hidden

" search improvements
set ignorecase
set smartcase

set incsearch

" Unbind annoying keybinding
nmap Q <nop>

" Enable mouse support
set mouse+=a

" set Danny's favorite colorblind colorscheme
" colorscheme delek

" Load filetype plugins (markdown, etc.) and their indent rules
filetype plugin indent on

" Prose: wrap long lines at word boundaries, keeping indentation
set wrap
set linebreak
set breakindent

" Move by screen line through wrapped text, unless given a count
nnoremap <expr> j v:count ? 'j' : 'gj'
nnoremap <expr> k v:count ? 'k' : 'gk'

" Spell check in prose files only
autocmd FileType markdown,text setlocal spell spelllang=en_us

" Copy yanks to the system clipboard via wl-clipboard (plain vim has no
" clipboard support); paste from the system with the terminal's Ctrl+Shift+V
if !has('clipboard') && executable('wl-copy')
  autocmd TextYankPost * if v:event.operator ==# 'y' |
        \ call system('wl-copy' . (v:event.regtype ==# 'v' ? ' -n' : ''), v:event.regcontents) |
        \ endif
endif
